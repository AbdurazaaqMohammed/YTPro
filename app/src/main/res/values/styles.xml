<resources>
	<style name="AppTheme" parent="@android:style/Theme.Material.Light.DarkActionBar">
		<item name="android:colorPrimary">@android:color/black</item>
		<item name="android:colorPrimaryDark">@android:color/black</item>
		<item name="android:colorAccent">@android:color/black</item>
		<item name="android:colorControlHighlight">@android:color/black</item>
		<item name="android:colorControlNormal">@android:color/black</item>
	</style>
	<style name="FullScreen" parent="@android:style/Theme.Material.Light.NoActionBar.Fullscreen">
		<item name="android:colorPrimary">@android:color/black</item>
		<item name="android:colorPrimaryDark">@android:color/black</item>
		<item name="android:colorAccent">@android:color/black</item>
		<item name="android:colorControlHighlight">@android:color/black</item>
		<item name="android:colorControlNormal">@android:color/black</item>
	</style>
	<style name="NoActionBar" parent="@android:style/Theme.Material.Light.NoActionBar">
		<item name="android:colorPrimary">@android:color/black</item>
		<item name="android:colorPrimaryDark">@android:color/black</item>
		<item name="android:colorAccent">@android:color/black</item>
		<item name="android:colorControlHighlight">@android:color/black</item>
		<item name="android:colorControlNormal">@android:color/black</item>
	</style>
	<style name="NoStatusBar" parent="AppTheme">
		<item name="android:windowFullscreen">true</item>
	</style>
	<style name="CustomDialogTheme">
		<item name="android:color">@color/purple</item>
		<item name="android:colorPrimary">@color/purple</item>
		<item name="android:colorPrimaryDark">@color/purple</item>
		<item name="android:colorAccent">@color/purple</item>
		<item name="android:colorControlHighlight">@color/purple</item>
		<item name="android:colorControlNormal">@color/purple</item>
		<item name="android:textColor">@color/purple</item>
		<item name="android:textColorAlertDialogListItem">@color/purple</item>
		<item name="android:textColorPrimary">@color/purple</item>
		<item name="android:buttonTint">@color/purple</item>
		<item name="android:background">@android:color/black</item>
	</style>
</resources>
